{
  "name": "amigo-invisible-mariace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "emulators": "firebase emulators:start --only firestore --project demo-amigo-invisible --import ./emulator-data --export-on-exit ./emulator-data",
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy:all": "pnpm --filter web build && firebase deploy --only hosting,firestore",
    "deploy:web": "pnpm --filter web build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}
