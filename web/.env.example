# Copia este fichero como `.env.production` y rellénalo con la configuración de
# tu app web (Consola de Firebase → Configuración del proyecto → Tus apps).
# Para trabajar con los emuladores NO hace falta: se usa el proyecto de prueba
# `demo-amigo-invisible`, que no existe en la nube ni cuesta nada.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=amigo-invisible-mariace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=amigo-invisible-mariace
VITE_FIREBASE_APP_ID=
